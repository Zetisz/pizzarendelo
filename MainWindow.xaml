<Window x:Class="pizzarendelo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pizzarendelo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="Lb" VerticalAlignment="Top" ></ListBox>
        <TextBox x:Name="TxtAdd" Text="" Height="50" Width="300" HorizontalAlignment="Left"></TextBox>
        <Button x:Name="BtnAdd" Height="50" Width="80" Click="BtnAdd_OnClick">Hozzáadás</Button>
        <Button x:Name="BtnDelete" Height="50" Width="80" Click="BtnDelete_OnClick" HorizontalAlignment="Right" Margin="0,0,250, 0">Törlés</Button>
        <Button x:Name="BtnOrder" Height="50" Width="100" Click="BtnOrder_OnClick" HorizontalAlignment="Right" Margin="0,0,50,0">Megrendelés</Button>
        <Label x:Name="Label" Content="" VerticalAlignment="Bottom" Height="100" FontSize="40"></Label>
    </Grid>
</Window>
